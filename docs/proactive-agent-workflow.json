{
  "options": {
    "type": "workflow_options",
    "name": "Proactive Context Agent",
    "description": "Continuously senses user context and proactively offers suggestions via an LLM agent with persistent memory."
  },
  "nodes": [
    {
      "type": "start_flow",
      "extra": {
        "name": "Start"
      }
    },
    {
      "type": "toolkit_config",
      "name": "contrib.toolkits.context_toolkit",
      "extra": {
        "name": "Context Toolkit"
      }
    },
    {
      "type": "timer_source_flow",
      "source_id": "ctx_timer",
      "interval_ms": 30000,
      "max_triggers": -1,
      "immediate": true,
      "extra": {
        "name": "Sense Timer (30s)"
      }
    },
    {
      "type": "loop_start_flow",
      "condition": true,
      "max_iter": 10000,
      "extra": {
        "name": "Proactive Loop"
      }
    },
    {
      "type": "event_listener_flow",
      "mode": "any",
      "extra": {
        "name": "Wait for Timer"
      }
    },
    {
      "type": "tool_flow",
      "method": "sense",
      "extra": {
        "name": "Sense Context"
      }
    },
    {
      "type": "transform_flow",
      "script": "import json\nctx = json.loads(input) if isinstance(input, str) else input\noutput = f\"\"\"You are a proactive assistant. Analyze the user's current context and decide what to do.\n\nCurrent context:\n{json.dumps(ctx, indent=2)}\n\nBased on this context, respond with a JSON object:\n{{\n  \"action\": \"suggest\" | \"idle\",\n  \"message\": \"your suggestion to the user (only if action=suggest)\",\n  \"reason\": \"brief explanation of why you chose this action\"\n}}\n\nRules:\n- Only suggest when you have something genuinely useful to say\n- Consider time of day, running applications, system load\n- Be concise and actionable\n- If nothing noteworthy, respond with action=idle\"\"\"",
      "extra": {
        "name": "Build Agent Prompt"
      }
    },
    {
      "type": "model_config",
      "extra": {
        "name": "Model"
      }
    },
    {
      "type": "agent_options_config",
      "instructions": [
        "You are a proactive context-aware assistant.",
        "You observe the user's system context and offer helpful suggestions.",
        "Always respond with valid JSON containing action, message, and reason fields.",
        "Only suggest when you have something genuinely useful — prefer idle over noise."
      ],
      "markdown": false,
      "extra": {
        "name": "Agent Persona"
      }
    },
    {
      "type": "content_db_config",
      "url": "storage/proactive_agent",
      "extra": {
        "name": "Agent Storage"
      }
    },
    {
      "type": "memory_manager_config",
      "query": true,
      "update": true,
      "managed": true,
      "extra": {
        "name": "Agent Memory"
      }
    },
    {
      "type": "agent_config",
      "extra": {
        "name": "Context Analyzer"
      }
    },
    {
      "type": "agent_flow",
      "extra": {
        "name": "Analyze Context"
      }
    },
    {
      "type": "transform_flow",
      "script": "import json\ntry:\n    resp = input.get('response', input) if isinstance(input, dict) else input\n    text = resp.get('content', resp) if isinstance(resp, dict) else str(resp)\n    start = text.find('{')\n    end = text.rfind('}') + 1\n    if start >= 0 and end > start:\n        parsed = json.loads(text[start:end])\n        output = parsed\n    else:\n        output = {'action': 'idle', 'reason': 'could not parse response'}\nexcept Exception as e:\n    output = {'action': 'idle', 'reason': str(e)}",
      "extra": {
        "name": "Parse Decision"
      }
    },
    {
      "type": "transform_flow",
      "script": "output = input.get('action', 'idle') if isinstance(input, dict) else 'idle'",
      "extra": {
        "name": "Extract Action"
      }
    },
    {
      "type": "route_flow",
      "extra": {
        "name": "Route Action"
      }
    },
    {
      "type": "preview_flow",
      "hint": "json",
      "extra": {
        "name": "Show Suggestion"
      }
    },
    {
      "type": "sink_flow",
      "extra": {
        "name": "Idle (no action)"
      }
    },
    {
      "type": "loop_end_flow",
      "extra": {
        "name": "Loop End"
      }
    },
    {
      "type": "end_flow",
      "extra": {
        "name": "End"
      }
    }
  ],
  "edges": [
    {
      "source": 0,
      "target": 2,
      "source_slot": "flow_out",
      "target_slot": "flow_in"
    },
