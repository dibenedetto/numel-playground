      "target_slot": "memory_mgr"
    },
    {
      "source": 11,
      "target": 12,
      "source_slot": "config",
      "target_slot": "config"
    },
    {
      "source": 6,
      "target": 12,
      "source_slot": "output",
      "target_slot": "request"
    },
    {
      "source": 12,
      "target": 13,
      "source_slot": "response",
      "target_slot": "input"
    },
    {
      "source": 13,
      "target": 14,
      "source_slot": "output",
      "target_slot": "input"
    },
    {
      "source": 14,
      "target": 15,
      "source_slot": "output",
      "target_slot": "target"
    },
    {
      "source": 13,
      "target": 15,
      "source_slot": "output",
      "target_slot": "input"
    },
    {
