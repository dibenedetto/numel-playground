      "markdown": true,
      "extra": { "name": "Agent Options" }
    },
    {
      "type": "tool_config",
      "name": "tools.read_file",
      "extra": { "name": "Tool: Read File" }
    },
    {
      "type": "tool_config",
      "name": "tools.write_file",
      "extra": { "name": "Tool: Write File" }
    },
    {
      "type": "agent_config",
      "extra": { "name": "Agent Config" }
    },
    {
      "type": "start_flow",
      "extra": { "name": "Start" }
