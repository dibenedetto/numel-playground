{
  "options": {
    "type": "workflow_options",
    "name": "Tutorial 9: File Tools & Agent Prompting",
    "description": "Read a file from disk and send its content as a request to an AI agent chat. Preview the agent's response."
  },
  "nodes": [
    {
      "type": "backend_config",
      "name": "agno",
      "extra": { "name": "Backend" }
    },
    {
      "type": "model_config",
      "source": "ollama",
      "name": "mistral",
      "extra": { "name": "Model (Ollama/Mistral)" }
