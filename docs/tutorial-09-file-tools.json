    {
      "type": "agent_chat",
      "extra": { "name": "Agent Chat" }
    },
    {
      "type": "preview_flow",
      "extra": { "name": "Response Preview" }
    },
    {
      "type": "end_flow",
      "extra": { "name": "End" }
    }
  ],
  "edges": [
