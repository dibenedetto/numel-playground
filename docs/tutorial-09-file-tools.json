    { "source": 1, "target": 5, "source_slot": "get", "target_slot": "model" },
    { "source": 2, "target": 5, "source_slot": "get", "target_slot": "options" },
    { "source": 3, "target": 7, "source_slot": "get", "target_slot": "config" },
    { "source": 4, "target": 5, "source_slot": "get", "target_slot": "tools.write_file" },
    { "source": 5, "target": 8, "source_slot": "get", "target_slot": "config" },
    { "source": 6, "target": 7, "source_slot": "flow_out", "target_slot": "flow_in" },
    { "source": 7, "target": 8, "source_slot": "output", "target_slot": "request" },
    { "source": 8, "target": 9, "source_slot": "response", "target_slot": "flow_in" },
