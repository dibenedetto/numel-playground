{
  "type": "workflow",
  "options": {
    "name": "proactive_substrate_stub",
    "description": "Substrate-only foundation for the Proactive Agent Ecology. A webhook signal flows through Middleware (Veracity, Privacy, Adversarial), is annotated with Goal Hierarchy + Capability Registry context, updates the World Model, passes the Governor, is recorded in the Ledger, and feeds Vitals. All Substrate components are stubs — agents (Sensory/Motor/Social/Conscious) plug into this scaffold later."
  },
  "nodes": [
    {
      "type": "start_flow",
      "extra": {"pos": [0, 0], "name": "Start"}
    },
    {
      "type": "webhook_source_flow",
      "endpoint": "/substrate/in",
      "methods": "POST",
      "extra": {"pos": [220, 0], "name": "Inbound Signal"}
    },
    {
      "type": "loop_start_flow",
      "condition": true,
      "max_iter": 100000,
      "extra": {"pos": [460, 0], "name": "Event Loop"}
    },
    {
      "type": "event_listener_flow",
      "mode": "any",
      "extra": {"pos": [700, 0], "name": "Wait for Signal"}
    },
    {"type": "veracity_gate_flow",    "extra": {"pos":  [940, 0], "name": "Middleware: Veracity"}},
    {"type": "privacy_gate_flow",     "extra": {"pos": [1180, 0], "name": "Middleware: Privacy"}},
    {"type": "adversarial_gate_flow", "extra": {"pos": [1420, 0], "name": "Middleware: Adversarial"}},
    {"type": "goal_match_flow",        "extra": {"pos": [1660, 0], "name": "Goal Hierarchy: Lookup"}},
    {"type": "capability_lookup_flow", "extra": {"pos": [1900, 0], "name": "Capability Registry: Lookup"}},
    {"type": "world_model_write_flow", "namespace": "core.inbox.last_envelope",
     "extra": {"pos": [2140, 0], "name": "World Model: Write"}},
    {"type": "governor_decide_flow",   "extra": {"pos": [2380, 0], "name": "Governor: Decide"}},
    {"type": "ledger_append_flow",     "topic": "core.middleware.input_received", "expected_outcome": "substrate_pass_through",
     "extra": {"pos": [2620, 0], "name": "Ledger: Append"}},
    {"type": "vitals_sweep_flow",      "extra": {"pos": [2860, 0], "name": "Vitals: Sweep"}},
    {
      "type": "preview_flow",
      "hint": "json",
      "extra": {"pos": [3100, 0], "name": "Show Snapshot"}
    },
    {
      "type": "loop_end_flow",
      "extra": {"pos": [3340, 0], "name": "Loop End"}
    },
    {
      "type": "end_flow",
      "extra": {"pos": [3580, 0], "name": "End"}
    }
  ],
  "edges": [
