      "extra": {
        "pos": [
          560,
          0
        ],
        "name": "Listen Email Channel"
      }
    },
    {
      "type": "loop_start_flow",
      "condition": true,
      "max_iter": 10000,
      "extra": {
        "pos": [
          800,
          0
        ],
        "name": "Event Loop"
      }
    },
    {
      "type": "event_listener_flow",
      "mode": "any",
      "extra": {
        "pos": [
          1040,
          0
        ],
        "name": "Wait for Email"
      }
    },
    {
      "type": "transform_flow",
      "lang": "python",
      "script": "# Filter: only process emails that have attachments\ne = input if isinstance(input, dict) else {}\natts = e.get('attachments', [])\nif not atts:\n    output = None  # skip — no attachments\nelse:\n    sender = e.get('sender_name', e.get('sender_id', 'unknown'))\n    meta = e.get('metadata', {})\n    subject = meta.get('subject', '(no subject)')\n    body = e.get('content', '')[:500]\n    att_desc = []\n    for a in atts:\n        name = a.get('filename') or 'unnamed'\n        mime = a.get('mime_type', '')\n        size = a.get('size')\n        s = f'{name} ({mime})'\n        if size:\n            kb = size / 1024\n            s += f' {kb:.0f}KB' if kb < 1024 else f' {kb/1024:.1f}MB'\n        att_desc.append(s)\n    prompt = f'Email from {sender}, subject: \"{subject}\"\\n'\n    prompt += f'Body preview: {body}\\n'\n    prompt += f'Attachments ({len(atts)}): ' + ', '.join(att_desc)\n    output = {\n        'prompt': prompt,\n        'attachments': atts,\n        'sender': sender,\n        'subject': subject,\n    }",
      "extra": {
        "pos": [
          1280,
          0
        ],
        "name": "Filter + Build Prompt"
      }
    },
    {
      "type": "if_else_flow",
      "condition": "input is not None",
      "extra": {
        "pos": [
          1520,
          0
        ],
        "name": "Has Attachments?"
      }
    },
    {
      "type": "transform_flow",
      "lang": "python",
      "script": "output = input.get('prompt', '') if isinstance(input, dict) else str(input)",
      "extra": {
        "pos": [
          1760,
          0
        ],
        "name": "Get Prompt"
      }
    },
    {
      "type": "agent_flow",
      "extra": {
        "pos": [
          2000,
          0
        ],
        "name": "Summarize"
      }
    },
    {
      "type": "transform_flow",
      "lang": "python",
      "script": "# Extract the agent response text\nr = input\nif isinstance(r, dict):\n    resp = r.get('response', {})\n    output = resp.get('content', str(resp)) if isinstance(resp, dict) else str(resp)\nelse:\n    output = str(r)",
      "extra": {
        "pos": [
          2240,
          0
        ],
        "name": "Extract Summary"
      }
    },
    {
      "type": "transform_flow",
      "lang": "python",
      "script": "# Retrieve attachments from context for Channel Send\n# The attachments list was stored in the filter node output\noutput = context.get('_node_8_output', {}).get('attachments', []) if isinstance(context.get('_node_8_output'), dict) else []",
      "extra": {
        "pos": [
          2240,
          180
        ],
        "name": "Get Attachments"
      }
    },
