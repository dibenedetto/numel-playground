      "name": "Attachment Summarizer",
      "instructions": [
        "You receive an email with file attachments. Summarize what was received in 1-2 sentences.",
        "Mention the sender, subject, number of attachments, and their types/filenames.",
        "Reply ONLY with the summary. Do NOT add greetings or sign-offs."
      ],
      "extra": {
        "pos": [
          0,
          460
        ],
        "name": "Agent Options"
      }
    },
