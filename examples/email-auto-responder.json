{
  "type": "workflow",
  "description": "Poll an email inbox for unread messages, use an agent to draft a reply, and send it back. Spam/automated emails are skipped when the agent replies with SKIP.",
  "nodes": [
    {
      "type": "start_flow",
      "extra": {
        "pos": [
          0,
          0
        ],
        "name": "Start"
      }
    },
    {
      "type": "model_config",
      "source": "ollama",
      "name": "mistral::latest",
      "extra": {
        "pos": [
          0,
          320
        ],
        "name": "Model (Mistral)"
      }
    },
    {
      "type": "agent_options_config",
      "name": "Email Responder",
      "instructions": [
        "You are a helpful assistant that replies to incoming emails.",
        "You receive the subject and body of an email. Write a polite, concise reply.",
        "Keep replies under 200 words. Do NOT use markdown — plain text only.",
        "If the email is spam or automated, reply with: SKIP"
      ],
      "extra": {
        "pos": [
          0,
          460
        ],
        "name": "Agent Options"
      }
    },
    {
      "type": "agent_config",
      "extra": {
        "pos": [
          280,
          320
        ],
        "name": "Agent Config"
      }
    },
    {
      "type": "toolkit_config",
      "name": "email_toolkit",
      "args": {
        "host": "smtp.gmail.com",
        "username": "${EMAIL_USER}",
        "password": "${EMAIL_PASSWORD}"
      },
      "extra": {
        "pos": [
          280,
          480
        ],
        "name": "Email Toolkit"
      }
    },
    {
      "type": "timer_source_flow",
      "interval_ms": 60000,
      "max_triggers": -1,
      "immediate": true,
      "extra": {
        "pos": [
          560,
          0
        ],
        "name": "Check Every 60s"
      }
    },
    {
      "type": "loop_start_flow",
      "condition": true,
      "max_iter": 10000,
      "extra": {
        "pos": [
          800,
          0
        ],
        "name": "Event Loop"
      }
    },
    {
      "type": "event_listener_flow",
      "mode": "any",
      "extra": {
        "pos": [
          1040,
          0
        ],
        "name": "Wait for Tick"
      }
    },
    {
      "type": "tool_flow",
      "method": "fetch",
      "args": {
        "folder": "INBOX",
        "limit": 1,
        "unread": true
      },
      "extra": {
        "pos": [
          1280,
          0
        ],
        "name": "Fetch Unread Email"
      }
    },
    {
      "type": "if_else_flow",
      "condition": "bool(value) and len(value) > 0",
      "extra": {
        "pos": [
          1520,
          0
        ],
        "name": "Has Email?"
      }
    },
    {
      "type": "transform_flow",
      "lang": "python",
      "script": "emails = input if isinstance(input, list) else [input]\ne = emails[0] if emails else {}\nsubject = e.get('subject', '(no subject)')\nbody = e.get('body', '')[:2000]\nsender = e.get('from', '')\noutput = f'Reply to this email.\\n\\nFrom: {sender}\\nSubject: {subject}\\n\\n{body}'",
      "extra": {
        "pos": [
          1760,
          0
        ],
        "name": "Build Prompt"
      }
    },
    {
      "type": "agent_flow",
      "extra": {
        "pos": [
          2000,
          0
        ],
        "name": "Draft Reply"
      }
    },
    {
      "type": "transform_flow",
      "lang": "python",
      "script": "r = input\nif isinstance(r, dict):\n    resp = r.get('response', {})\n    reply = resp.get('content', str(resp)) if isinstance(resp, dict) else str(resp)\nelse:\n    reply = str(r)\noutput = reply.strip() if reply.strip().upper() != 'SKIP' else None",
      "extra": {
        "pos": [
          2240,
          0
        ],
        "name": "Extract & Filter"
      }
    },
    {
      "type": "if_else_flow",
      "condition": "value is not None and value != ''",
      "extra": {
        "pos": [
          2480,
          0
        ],
        "name": "Not Spam?"
      }
    },
    {
      "type": "preview_flow",
      "hint": "text",
      "extra": {
        "pos": [
          2720,
          0
        ],
        "name": "Log Reply"
      }
    },
    {
      "type": "tool_flow",
      "method": "mark_read",
      "args": {
        "folder": "INBOX",
        "count": 1
      },
      "extra": {
        "pos": [
          2960,
          0
        ],
        "name": "Mark Read"
      }
    },
    {
      "type": "loop_end_flow",
      "extra": {
        "pos": [
          3200,
          0
        ],
        "name": "Loop End"
      }
    },
    {
      "type": "end_flow",
