{
	"id": "comfyui01",
	"title": "ComfyUI: Agent-Guided Image Generation",
	"description": "An agent writes an optimized prompt, sends it to ComfyUI for generation, evaluates the result, and refines if quality is low. Demonstrates Numel's unique advantage: automated prompt optimization over ComfyUI.",
	"category": "comfyui",
	"tags": ["comfyui", "image-generation", "agent", "eval", "prompt-optimization"],
	"author": "system",
	"created_at": 1742486400.0,
	"workflow": {
		"type": "workflow",
		"nodes": [
			{
				"type": "start_flow",
				"extra": {"pos": [50, 300], "name": "Start"}
			},
			{
				"type": "user_input_flow",
				"query": "Describe what you want to generate (e.g., 'a cat wearing a top hat'):",
				"extra": {"pos": [250, 300], "name": "User Prompt"}
			},
			{
				"type": "backend_config",
				"name": "agno",
				"extra": {"pos": [250, 50], "name": "Backend"}
			},
			{
				"type": "model_config",
				"source": "ollama",
				"name": "mistral",
				"extra": {"pos": [450, 50], "name": "Model"}
			},
			{
				"type": "agent_options_config",
				"instructions": [
					"You are a Stable Diffusion prompt engineer. Given a user description, write an optimized image generation prompt.",
					"Use descriptive keywords, quality boosters (masterpiece, best quality, detailed), and style tags.",
					"If you receive feedback about a previous generation, incorporate it to improve the prompt.",
					"Output ONLY the prompt text, nothing else."
				],
				"extra": {"pos": [650, 50], "name": "Prompt Engineer Instructions"}
			},
			{
				"type": "agent_config",
				"extra": {"pos": [850, 100], "name": "Prompt Engineer"}
			},
			{
				"type": "loop_start_flow",
				"max_iter": 3,
				"extra": {"pos": [500, 300], "name": "Refinement Loop"}
			},
			{
				"type": "transform_flow",
				"lang": "python",
				"script": "desc = variables.get('user_desc', input or '')\nfeedback = variables.get('feedback', '')\nif feedback:\n    output = f'User wants: {desc}\\n\\nPrevious feedback: {feedback}\\nImprove the prompt.'\nelse:\n    output = f'User wants: {desc}\\nWrite an optimized Stable Diffusion prompt.'",
				"extra": {"pos": [700, 300], "name": "Build Agent Input"}
			},
			{
				"type": "agent_flow",
				"extra": {"pos": [950, 300], "name": "Write Prompt"}
			},
			{
				"type": "toolkit_config",
				"name": "comfyui_toolkit",
				"args": {"url": "http://localhost:8188"},
				"extra": {"pos": [950, 150], "name": "ComfyUI Connection"}
			},
			{
				"type": "tool_flow",
				"method": "generate_simple",
				"args": {"width": 512, "height": 512, "steps": 20, "cfg": 7.0},
				"extra": {"pos": [1200, 300], "name": "Generate Image"}
			},
			{
				"type": "preview_flow",
				"hint": "image",
				"extra": {"pos": [1450, 300], "name": "Preview Image"}
			},
			{
				"type": "eval_flow",
				"script": "result = input or {}\nif isinstance(result, str):\n    import json\n    try: result = json.loads(result)\n    except: pass\nimages = result.get('images', []) if isinstance(result, dict) else []\nerror = result.get('error', '') if isinstance(result, dict) else ''\nif error:\n    score = 0.0\n    feedback = f'Generation failed: {error}'\nelif len(images) > 0:\n    score = 0.8\n    feedback = f'Generated {len(images)} image(s) successfully'\nelse:\n    score = 0.2\n    feedback = 'No images generated'",
				"extra": {"pos": [1650, 300], "name": "Evaluate Output"}
			},
			{
				"type": "if_else_flow",
				"condition": "value >= 0.7",
				"extra": {"pos": [1850, 300], "name": "Good Enough?"}
			},
			{
				"type": "transform_flow",
				"lang": "python",
				"script": "variables['feedback'] = str(input or '')\noutput = input",
				"extra": {"pos": [1850, 500], "name": "Store Feedback"}
			},
			{
				"type": "loop_end_flow",
				"extra": {"pos": [2050, 500], "name": "Retry"}
			},
			{
				"type": "end_flow",
				"extra": {"pos": [2100, 300], "name": "Done"}
			}
		],
		"edges": [
